# Entorno de ejecución (development | production)
FLASK_ENV=development
FLASK_DEBUG=true
PORT=5000

# Base de datos (En producción MySQL es obligatorio; en desarrollo si se omite usa SQLite local)
DATABASE_URL=mysql+pymysql://pymes_user:pymes_password@localhost:3306/pymes_db

# Seguridad JWT (Obligatorio cambiar en producción)
JWT_SECRET_KEY=cambiar_por_una_clave_secreta_aleatoria_de_minimo_32_bytes

# Cifrado Fernet para llaves privadas de pasarelas de pago (Obligatorio en producción)
# Generar con: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
PAGOS_ENC_KEY=

# Orígenes CORS permitidos (separados por coma)
CORS_ORIGINS=http://127.0.0.1:5001,http://localhost:5001,http://127.0.0.1:5002,http://localhost:5002

# URLs de los Frontends
FRONTEND_ADMIN_URL=http://127.0.0.1:5001
FRONTEND_CLIENTES_URL=http://127.0.0.1:5002
PUBLIC_BASE_URL=http://127.0.0.1:5000

# Configuración SMTP para despacho de códigos OTP y notificaciones por correo
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=PYMESOFT <noreply@pymesoft.com>
