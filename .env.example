# ==== Backend PYMES – variables de entorno (copiar a .env o definir en docker-compose) ====
# Base de datos (si no se define o falla la conexión se usa SQLite en PYMES_BE/pymes.db)
DATABASE_URL=
JWT_SECRET_KEY=
PORT=5000

# ==== Pagos ====
# Clave Fernet para cifrar las llaves de pasarela guardadas en la BD (muy recomendado en producción).
# Generar: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# ¡No la pierdas! Sin ella no se pueden descifrar las llaves ya guardadas.
PAGOS_ENC_KEY=

# URL pública HTTPS del backend. Se usa para la página de retorno del checkout de Wompi.
# En Wompi/Bold configura los webhooks así:
#   Wompi -> {PUBLIC_BASE_URL}/api/webhooks/wompi
#   Bold  -> {PUBLIC_BASE_URL}/api/webhooks/bold
PUBLIC_BASE_URL=

# Minutos sin confirmación tras los cuales la conciliación marca un cobro como EXPIRADO
PAGOS_MINUTOS_EXPIRACION=30
